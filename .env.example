# Copy this file to `.env` and fill in your keys.
# The .env file is loaded automatically by ecosystem.config.js on PM2 start.

# --- REQUIRED ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- OPTIONAL ---
# ElevenLabs is an alternative TTS provider; OpenAI TTS is used if this is blank.
ELEVENLABS_API_KEY=

# YouTube Data API v3 key — enriches competitor signals.
# Without it, competitor research falls back to Reddit only.
YT_API_KEY=

# --- TUNING ---
PORT=3000
LIVE_PORT=3001
TICK_INTERVAL_MS=15000
# Researcher polls RSS this often (default 6h = 21600000 ms).
RESEARCHER_INTERVAL_MS=21600000
