{
  "name": "cfo-content-engine",
  "version": "0.1.0",
  "description": "Autonomous content engine for CFO-targeted video production. Tracks video projects through their lifecycle (Idea -> Scripted -> Audio_Generated -> Rendered -> Published) to prevent wasted API credits on re-runs after failure.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "orchestrator": "node main.js",
    "live": "node gemini-live-server.js",
    "seed": "node seed.js",
    "pm2:start": "pm2 start ecosystem.config.js && pm2 save",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs"
  },
  "keywords": [
    "content-engine",
    "sqlite",
    "automation",
    "video-pipeline"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@google-cloud/storage": "^7.19.0",
    "@supabase/supabase-js": "^2.103.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "socket.io": "^4.8.0",
    "ws": "^8.20.0"
  }
}
